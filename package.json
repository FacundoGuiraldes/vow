{
  "name": "vow-agents",
  "version": "1.0.0",
  "description": "Agentes de IA para VOW",
  "main": "index.js",
  "scripts": {
    "test": "node --test",
    "hola": "node src/hola.js",
    "prueba": "node src/prueba.js",
    "costos": "node src/costos-prueba.js",
    "db-probar": "node src/db/probar-conexion.js",
    "servidor": "node src/api/servidor.js",
    "db-migrar": "node src/db/migrar.js",
    "db-seed": "node src/db/seed-catalogo.js",
    "dev": "bash .devcontainer/iniciar.sh",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:smoke": "playwright test -c e2e/playwright.config.ts --grep @smoke",
    "test:e2e:ui": "playwright test -c e2e/playwright.config.ts --ui",
    "test:e2e:report": "playwright show-report e2e/playwright-report --host 0.0.0.0",
    "test:e2e:tipos": "tsc -p e2e/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FacundoGuiraldes/vow.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/FacundoGuiraldes/vow/issues"
  },
  "homepage": "https://github.com/FacundoGuiraldes/vow#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "playwright-core": "1.63.0",
    "typescript": "6.0.3"
  }
}
