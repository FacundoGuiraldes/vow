ANTHROPIC_API_KEY=
DATABASE_URL=
ALLOWED_ORIGINS=
VITE_API_URL=
# Dirección https de una tienda externa. Vacía: la landing no muestra el botón "Ir a la tienda"
VITE_TIENDA_URL=
TRUST_PROXY=
# Tope de gasto mensual en dólares para los comandos que usan la IA (por defecto 5)
TOPE_MENSUAL_USD=
# API oficial de Meta (Instagram con inicio de sesión de Facebook): token de acceso e ID de la cuenta de Instagram de VOW
INSTAGRAM_TOKEN=
INSTAGRAM_USER_ID=
# 1 habilita publicar de verdad (MCP y publicación programada). Vacío = solo lectura / simulación
INSTAGRAM_PERMITIR_PUBLICAR=

# Publicación programada de Instagram (bot de Telegram, aviso de las 8, publicación a la hora). Todas obligatorias para activarla.
# Token del bot (se crea hablando con @BotFather en Telegram)
TELEGRAM_TOKEN=
# Tu chat con el bot: mandale /start al bot y te dice el número
TELEGRAM_CHAT_ID=
# Secreto del webhook: inventalo, de 16 a 256 caracteres con letras, números, guion y guion bajo
TELEGRAM_WEBHOOK_SECRETO=
# Clave con la que GitHub Actions y cron-job.org llaman a la API (inventala, larga)
PROGRAMACION_SECRETO=
# Dirección pública de la API (sin barra final), por ejemplo https://vow-2i0f.onrender.com
URL_PUBLICA=
# Imágenes con IA (opcional: sin esto, las imágenes las mandás vos).
# Cloudflare Workers AI (FLUX): 10.000 neurons gratis por día. Account ID: panel de Cloudflare, barra lateral de Workers & Pages.
# Token: https://dash.cloudflare.com/profile/api-tokens, con el permiso "Workers AI".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Alternativa: Gemini, solo con plan pago de Google (el plan gratis no incluye imágenes)
GEMINI_API_KEY=
GEMINI_MODELO=
# Chat con la IA por Telegram (Gemini, plan gratis de Google AI Studio). Sin la clave, el bot responde con botones y comandos.
# Modelo del chat (por defecto gemini-3.6-flash). Elegí uno con plan gratis en https://ai.google.dev/gemini-api/docs/pricing
GEMINI_MODELO_CHAT=

# Venta propia con Mercado Pago (src/pagos). Sin las tres primeras no se arma. VENTA_ABIERTA=1 abre la venta al público.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRETO=
URL_LANDING=
VENTA_ABIERTA=
# Costo fijo de envío en pesos (sin cotizador automático todavía). Vacío: solo retiro en persona.
ENVIO_COSTO_FIJO=

# Descuento para la lista de espera: mail con código único por persona, enviado desde la cuenta de Gmail de VOW.
# MAIL_CLAVE_APP es una "contraseña de aplicación" de Google (Cuenta de Google > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones), no la contraseña normal.
# Se dispara a mano desde el bot de Telegram (herramienta descuento_lista_espera). Requiere también URL_LANDING.
# Render gratis bloquea el correo por SMTP: en Render se usa la API de Gmail (internet normal) con estas tres claves de Google Cloud.
MAIL_USUARIO=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
MAIL_CLAVE_APP=
DESCUENTO_LISTA_PORCENTAJE=10
DESCUENTO_LISTA_DIAS=14
# Drop al que corresponden los códigos (00 por defecto). Al abrir el siguiente: DROP_ACTUAL=01 y LISTA_CORTE con la fecha de lanzamiento
# del Drop 00; solo reciben código quienes se anotaron antes de esa fecha, y los códigos del 00 dejan de servir.
# DROP_ACTUAL=00
# LISTA_CORTE=2026-11-14T00:00:00-03:00
